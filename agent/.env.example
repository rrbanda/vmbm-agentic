# =============================================================================
# VMware-to-OCP Virt Migration Agent -- Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All values can also be set as OpenShift Deployment env vars or via ConfigMap.

# -- LLM Provider --
# The OpenAI-compatible API endpoint for the language model.
# For vLLM on RHOAI: https://<inference-service>.<namespace>.svc:8080/v1
# For Llama Stack on RHOAI: https://<llamastack-route>/v1
OPENAI_API_BASE=
OPENAI_API_KEY=not-needed

# The model identifier (must match what the serving runtime exposes).
# Examples: openai/gpt-oss-120b, openai/meta-llama/Llama-3.1-70B-Instruct
ADK_MODEL=openai/gpt-oss-120b

# -- Agent Config --
AGENT_NAME=migration_agent
AGENT_MODE=single

# -- LLM Generation Parameters --
ADK_TEMPERATURE=0.2
ADK_MAX_OUTPUT_TOKENS=4096

# -- MTV Cluster (Forklift providers, plans, migrations) --
# Leave empty for in-cluster auth. Set for remote multi-cluster access.
MTV_API_URL=
MTV_API_TOKEN=
MTV_API_CA=

# -- OCP Virt Cluster (KubeVirt VMs, pod logs) --
# Falls back to MTV cluster config when empty.
VIRT_API_URL=
VIRT_API_TOKEN=
VIRT_API_CA=

# -- MTV Inventory (Forklift inventory HTTP API) --
# Leave empty to auto-discover from Route CR.
MTV_INVENTORY_URL=
MTV_INVENTORY_TOKEN=

# -- Namespace Defaults --
DEFAULT_MTV_NAMESPACE=mtv-user1
DEFAULT_VIRT_NAMESPACE=vmimported-user1
MTV_OPERATOR_NAMESPACE=openshift-mtv

# -- AAP (Ansible Automation Platform) --
AAP_URL=
AAP_TOKEN=
AAP_API_PREFIX=/api/controller/v2
PRE_MIGRATION_TEMPLATE_ID=
POST_MIGRATION_TEMPLATE_ID=
